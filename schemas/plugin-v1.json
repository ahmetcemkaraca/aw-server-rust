{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PeakActivity Plugin Contract V1",
  "oneOf": [
    {"$ref": "#/definitions/PluginManifestV1"},
    {"$ref": "#/definitions/SignedPluginPackageV1"},
    {"$ref": "#/definitions/PluginCapabilityDiffV1"},
    {"$ref": "#/definitions/PluginCapabilitiesV1"},
    {"$ref": "#/definitions/PluginInvocationInputV1"},
    {"$ref": "#/definitions/PluginInvocationOutputV1"}
  ],
  "definitions": {
    "PluginManifestV1": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "plugin_id", "version", "publisher_key_id", "display_name", "description", "capabilities"],
      "properties": {
        "schema_version": {"const": 1, "type": "integer"},
        "plugin_id": {"type": "string", "maxLength": 64, "pattern": "^[a-z][a-z0-9._-]*$"},
        "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
        "publisher_key_id": {"type": "string", "maxLength": 64, "pattern": "^[a-z][a-z0-9._-]*$"},
        "display_name": {"type": "string", "minLength": 1, "maxLength": 80},
        "description": {"type": "string", "maxLength": 1000},
        "capabilities": {"$ref": "#/definitions/PluginCapabilitiesV1"}
      }
    },
    "PluginCapabilitiesV1": {
      "type": "object", "additionalProperties": false,
      "required": ["read", "write", "network", "ai_features", "storage", "ui", "background", "destructive"],
      "properties": {
        "read": {"type": "array", "maxItems": 32, "default": [], "items": {"$ref": "#/definitions/PluginReadCapabilityV1"}},
        "write": {"type": "array", "maxItems": 32, "default": [], "items": {"$ref": "#/definitions/PluginWriteCapabilityV1"}},
        "network": {"type": "array", "maxItems": 32, "default": [], "items": {"$ref": "#/definitions/PluginNetworkCapabilityV1"}},
        "ai_features": {"type": "array", "maxItems": 5, "uniqueItems": true, "default": [], "items": {"type": "string", "enum": ["question_answer", "report_explanation", "category_suggestion", "freelancer_draft", "pattern_comparison"]}},
        "storage": {"oneOf": [{"type": "null"}, {"$ref": "#/definitions/PluginStorageCapabilityV1"}]},
        "ui": {"type": "array", "maxItems": 32, "uniqueItems": true, "default": [], "items": {"type": "string", "enum": ["settings_panel", "work_report", "toolbar_action"]}},
        "background": {"oneOf": [{"type": "null"}, {"$ref": "#/definitions/PluginBackgroundCapabilityV1"}]},
        "destructive": {"type": "array", "maxItems": 32, "uniqueItems": true, "default": [], "items": {"$ref": "#/definitions/PluginDestructiveCapabilityV1"}}
      }
    },
    "PluginReadCapabilityV1": {
      "type": "object", "additionalProperties": false,
      "oneOf": [
        {"properties": {"data_class": {"const": "raw"}}},
        {"properties": {"data_class": {"const": "aggregate"}, "fields": {"items": {"enum": ["/event_count", "/total_duration_seconds"]}}}}
      ],
      "required": ["data_class", "bucket_type", "event_type", "time_window_days", "fields"],
      "properties": {
        "data_class": {"type": "string", "enum": ["raw", "aggregate"]},
        "bucket_type": {"type": "string", "maxLength": 64, "pattern": "^[a-z][a-z0-9._-]*$"},
        "event_type": {"type": "string", "maxLength": 64, "pattern": "^[a-z][a-z0-9._-]*$"},
        "time_window_days": {"type": "integer", "minimum": 1, "maximum": 365},
        "fields": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128, "not": {"pattern": "\\*"}}}
      }
    },
    "PluginWriteCapabilityV1": {
      "type": "object", "additionalProperties": false, "required": ["event_type", "schema_id"],
      "properties": {"event_type": {"type": "string", "maxLength": 64, "pattern": "^[a-z][a-z0-9._-]*$"}, "schema_id": {"type": "string", "maxLength": 64, "pattern": "^[a-z][a-z0-9._-]*$"}}
    },
    "PluginNetworkCapabilityV1": {
      "type": "object", "additionalProperties": false, "required": ["domain", "destination_id", "purpose_id", "payload_class"],
      "properties": {
        "domain": {"type": "string", "maxLength": 253, "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+$"},
        "destination_id": {"type": "string", "maxLength": 64, "pattern": "^[a-z][a-z0-9._-]*$"},
        "purpose_id": {"type": "string", "maxLength": 64, "pattern": "^[a-z][a-z0-9._-]*$", "not": {"pattern": "^(ai\\.|sync-object-v1$)"}},
        "payload_class": {"type": "string", "enum": ["aggregate", "approved_timesheet", "plugin_metadata"]}
      }
    },
    "PluginStorageCapabilityV1": {
      "type": "object", "additionalProperties": false, "required": ["quota_bytes", "encrypted"],
      "properties": {"quota_bytes": {"type": "integer", "minimum": 1, "maximum": 524288}, "encrypted": {"const": true, "type": "boolean"}}
    },
    "PluginBackgroundCapabilityV1": {
      "type": "object", "additionalProperties": false, "required": ["minimum_interval_seconds", "maximum_runtime_ms", "maximum_memory_bytes"],
      "properties": {"minimum_interval_seconds": {"type": "integer", "minimum": 900}, "maximum_runtime_ms": {"type": "integer", "minimum": 1, "maximum": 30000}, "maximum_memory_bytes": {"type": "integer", "minimum": 1, "maximum": 134217728}}
    },
    "PluginDestructiveCapabilityV1": {
      "type": "object", "additionalProperties": false, "required": ["action", "confirmation_required"],
      "properties": {"action": {"type": "string", "enum": ["export", "delete", "send"]}, "confirmation_required": {"const": true, "type": "boolean"}}
    },
    "PluginInvocationInputV1": {
      "type": "object", "additionalProperties": false, "required": ["schema_version", "records"],
      "properties": {"schema_version": {"const": 1, "type": "integer"}, "records": {"type": "array", "maxItems": 512, "items": {"$ref": "#/definitions/PluginInputRecordV1"}}, "storage": {"type": "object", "propertyNames": {"type": "string", "minLength": 1, "maxLength": 128}, "additionalProperties": true}}
    },
    "PluginInputRecordV1": {
      "type": "object", "additionalProperties": false, "required": ["data_class", "bucket_type", "event_type", "captured_at", "payload"],
      "properties": {
        "data_class": {"type": "string", "enum": ["raw", "aggregate"]},
        "bucket_type": {"type": "string", "maxLength": 64, "pattern": "^[a-z][a-z0-9._-]*$"},
        "event_type": {"type": "string", "maxLength": 64, "pattern": "^[a-z][a-z0-9._-]*$"},
        "captured_at": {"type": "string", "format": "date-time"},
        "time_window_days": {"type": "integer", "minimum": 1, "maximum": 365}, "payload": {"type": "object"}
      }
    },
    "PluginInvocationOutputV1": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "ui", "writes", "network", "ai", "storage", "destructive"],
      "properties": {
        "schema_version": {"const": 1, "type": "integer"},
        "ui": {"type": "array", "maxItems": 32, "items": {"$ref": "#/definitions/PluginUIOutputV1"}},
        "writes": {"type": "array", "maxItems": 32, "items": {"$ref": "#/definitions/PluginWriteIntentV1"}},
        "network": {"type": "array", "maxItems": 32, "items": {"$ref": "#/definitions/PluginNetworkIntentV1"}},
        "ai": {"type": "array", "maxItems": 32, "items": {"$ref": "#/definitions/PluginAIIntentV1"}},
        "storage": {"type": "array", "maxItems": 32, "items": {"$ref": "#/definitions/PluginStorageIntentV1"}},
        "destructive": {"type": "array", "maxItems": 32, "items": {"$ref": "#/definitions/PluginDestructiveIntentV1"}}
      }
    },
    "PluginUIOutputV1": {
      "type": "object", "additionalProperties": false, "required": ["surface", "title", "text"],
      "properties": {"surface": {"type": "string", "enum": ["settings_panel", "work_report", "toolbar_action"]}, "title": {"type": "string", "minLength": 1, "maxLength": 80}, "text": {"type": "string", "maxLength": 16384}}
    },
    "PluginWriteIntentV1": {
      "type": "object", "additionalProperties": false, "required": ["event_type", "schema_id", "payload"],
      "properties": {
        "event_type": {"const": "plugin.annotation"},
        "schema_id": {"const": "annotation-v1"},
        "payload": {
          "type": "object", "additionalProperties": false, "required": ["title", "body"],
          "properties": {
            "title": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": ".*\\S.*"},
            "body": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": ".*\\S.*"}
          }
        }
      }
    },
    "PluginNetworkIntentV1": {
      "type": "object", "additionalProperties": false, "required": ["domain", "destination_id", "purpose_id", "payload_class", "payload"],
      "properties": {"domain": {"type": "string"}, "destination_id": {"type": "string"}, "purpose_id": {"type": "string"}, "payload_class": {"type": "string", "enum": ["aggregate", "approved_timesheet", "plugin_metadata"]}, "payload": {"type": "object"}}
    },
    "PluginAIIntentV1": {
      "type": "object", "additionalProperties": false, "required": ["feature", "question", "aggregate"],
      "properties": {"feature": {"type": "string", "enum": ["question_answer", "report_explanation", "category_suggestion", "freelancer_draft", "pattern_comparison"]}, "question": {"type": "string", "minLength": 1, "maxLength": 4096}, "aggregate": {"type": "object"}}
    },
    "PluginStorageIntentV1": {
      "type": "object", "additionalProperties": false, "required": ["key", "value"],
      "properties": {"key": {"type": "string", "minLength": 1, "maxLength": 128}, "value": {}}
    },
    "PluginDestructiveIntentV1": {
      "type": "object", "additionalProperties": false, "required": ["action", "resource_id"],
      "properties": {"action": {"type": "string", "enum": ["export", "delete", "send"]}, "resource_id": {"type": "string", "minLength": 1, "maxLength": 128}}
    },
    "SignedPluginPackageV1": {
      "type": "object", "additionalProperties": false, "required": ["schema_version", "manifest", "module_sha256", "signature"],
      "properties": {"schema_version": {"const": 1, "type": "integer"}, "manifest": {"$ref": "#/definitions/PluginManifestV1"}, "module_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "signature": {"type": "array", "minItems": 64, "maxItems": 64, "items": {"type": "integer", "minimum": 0, "maximum": 255}}}
    },
    "PluginCapabilityDiffV1": {
      "type": "object", "additionalProperties": false, "required": ["added", "removed", "requires_reconsent"],
      "properties": {"added": {"type": "array", "items": {"type": "string"}}, "removed": {"type": "array", "items": {"type": "string"}}, "requires_reconsent": {"type": "boolean"}}
    }
  }
}
